{
  "id": "/?source=pwa",
  "name": "MediBrid",
  "short_name": "MediBrid",
  "description": "Your Health Partner",
  "start_url": "/",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#ffffff",
  "theme_color": "#0d9488",
  "orientation": "portrait",
  "categories": ["health", "medical", "lifestyle"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.medibrid.app",
      "id": "com.medibrid.app"
    },
    {
      "platform": "windows",
      "url": "https://www.microsoft.com/store/apps/9medibridapp"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "scope_extensions": [
    {
      "origin": "https://medibrid-v2.vercel.app"
    }
  ],
  "note_taking": {
    "new_note_url": "/?action=note"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "widgets": [
    {
      "name": "MediBrid Quick Actions",
      "description": "Quickly access health services",
      "tag": "medibrid-widget",
      "ms_ac_template": "/widget/template.json",
      "data": "/widget/data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/icon-512.svg",
          "sizes": "512x512",
          "label": "MediBrid Widget"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.svg",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/?action=open-file",
      "accept": {
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "auto"
  },
  "shortcuts": [
    {
      "name": "Book Appointment",
      "short_name": "Book",
      "description": "Book a new doctor appointment",
      "url": "/?action=book",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "View Profile",
      "short_name": "Profile",
      "description": "View your medical profile",
      "url": "/?action=profile",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+medibrid",
      "url": "/?action=%s"
    }
  ],
  "share_target": {
    "action": "/?share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "screenshots": [
    {
      "src": "/1782229544546_transfer_2026-08-13_234035.png",
      "sizes": "1360x784",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/file_000000000840720883a793af7df2f858_transfer_2026-08-13_234035.png",
      "sizes": "1402x1122",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
